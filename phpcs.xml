<?xml version="1.0"?>
<!--
    A project configuration built on the BearSunday standard.

    This is a template to copy into a project. Everything below this comment is
    project-local: which directories to scan and how to run. The rules themselves
    live in BearSunday/ruleset.xml and are pulled in by the single
    <rule ref="BearSunday"/> line, so updates to the standard arrive with
    `composer update` instead of needing this file to be copied again.
-->
<ruleset
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="vendor/squizlabs/php_codesniffer/phpcs.xsd">

    <arg name="basepath" value="."/>
    <arg name="extensions" value="php"/>
    <arg name="parallel" value="80"/>
    <arg name="cache" value=".phpcs-cache"/>

    <!-- Lowest PHP version you support. Without it phpcs assumes the PHP it
         happens to be running on, so results differ between CI legs. -->
    <config name="php_version" value="70400"/>

    <!-- Ignore warnings, show progress of the run and show sniff names -->
    <arg value="nps"/>

    <!-- Directories to be checked. These patterns are matched against the whole
         absolute path, unanchored and case-insensitively, so */tmp/* also skips
         src/Tmp/ and skips everything if the checkout itself lives under /tmp.
         Narrow them to your layout if that bites; they are kept as they were
         before the BearSunday standard was split out. -->
    <file>src</file>
    <file>tests</file>
    <exclude-pattern>*/Fake/*</exclude-pattern>
    <exclude-pattern>*/tmp/*</exclude-pattern>
    <exclude-pattern>*/tests/tmp/*</exclude-pattern>

    <rule ref="BearSunday"/>
</ruleset>
