<?xml version="1.0"?>
<!--
    Exercises the inheritance path: the standard is referenced by name, not
    copied. Once the workflow's smoke job is in place, a break in registration
    through dealerdirect/phpcodesniffer-composer-installer, or in
    BearSunday/ruleset.xml as a standalone ruleset, fails here.

    No top-level <exclude-pattern>: those match the whole absolute path, and this
    fixture is checked out wherever CI puts it.
-->
<ruleset
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="vendor/squizlabs/php_codesniffer/phpcs.xsd">

    <arg name="basepath" value="."/>
    <arg name="extensions" value="php"/>
    <arg value="nps"/>

    <config name="php_version" value="70400"/>

    <file>src</file>
    <file>tests</file>

    <rule ref="BearSunday"/>
</ruleset>
